[Unit]
Description=Daily trigger for branchleft-db-prune.service

[Timer]
# After the nightly dump (03:10 UTC) and at least one more binlog-ship run
# have had time to land, so this run's listing never mistakes a dump still
# in flight for a missed one.
OnCalendar=*-*-* 03:45:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target

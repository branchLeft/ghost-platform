{
  "extends": "./tsconfig.json",
  // The shared base sets `noEmit`, because most projects extending it only
  // ever type-check. This package has to produce dist/, which the collector
  // resolves through its link: dependency.
  "compilerOptions": {
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts", "vitest.config.ts"]
}

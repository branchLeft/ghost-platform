# Repo-specific only. Build output, lockfiles, generated artefacts and sibling
# worktrees come from the shared set in
# node_modules/@branchleft/prettier-config/prettierignore, and .gitignore is
# passed as a third ignore path — see the `format` scripts in package.json.

# Markdown belongs to docs-lint, which already gates every .md file in this
# repo. Prettier's markdown pass only rewrites emphasis markers and re-wraps
# prose, which is churn against a linter that owns the same files.
*.md

# Pulumi's tsc output directory. Untracked, so .gitignore does not list it.
bin/

# Vendored, pinned third-party bundles. Their bytes are content-addressed
# in widgets/pins.json by sha384; reformatting them changes those bytes and
# breaks the pin.
widgets/dist/

# Vendored third-party Kalotyp bundle (vendor/kalotyp/README.md). Pinned by
# sha256 in vendor/kalotyp/kalotyp.sha256 and checked at image build: any
# reformatting changes the bytes and breaks the pin.
vendor/kalotyp/kalotyp.js
vendor/kalotyp/kalotyp.css

# The unit tests' build output (adapters/sso/ghost-core-overlay/README.md): Ghost's
# own file with our patch applied. Its bytes are pinned by a hash, so house style
# must never be applied to it. Git-ignored; listed here so a local format run
# does not touch it either.
adapters/sso/ghost-core-overlay/derived/

# Speckify's output for the broker contract, committed as generated and checked
# byte for byte by scripts/assert-broker-contract-generated.py -- reformatting
# it would be reported there as drift.
services/broker/src/generated/

# The rendered demo1 mail-spool Compose file, compared byte for byte with the
# renderer's output by render-core/test/spool.golden.test.ts. Prettier would
# re-quote its healthcheck line and the test would fail.
render-core/test/golden/mail-spool-compose.demo1.yml

# /etc/branchleft/erase-tenant-backup.env -- root:root, mode 0600. Read only by
# erase_tenant_backup_identity.py, which refuses to run unless every name below
# is set. Values are placeholders and never belong in this file.
#
# The credential is for the spare bucket and nothing else: list and delete,
# including object versions, on the `spares/` prefix. It needs no Get and no Put,
# and the erasure never reads a spare. It is a different credential from the
# enrolment's, and its bucket name and access key id must both differ from
# every copy in backup-worker.env and restore-drill.env.
ERASE_BACKUP_SPARE_BUCKET=SPARE_BUCKET_NAME
ERASE_BACKUP_SPARE_ENDPOINT=SPARE_BUCKET_ENDPOINT
ERASE_BACKUP_SPARE_REGION=SPARE_BUCKET_REGION
ERASE_BACKUP_SPARE_ACCESS_KEY_ID=SPARE_ERASE_KEY_ID
ERASE_BACKUP_SPARE_SECRET_ACCESS_KEY=SPARE_ERASE_KEY_SECRET

# /etc/branchleft/enrol-tenant-backup.env -- root:root, mode 0600. Read only by
# enrol_tenant_backup.py, which refuses to run unless every name below is set.
# Values are placeholders and never belong in this file.
#
# The spare bucket is private and is not any dump copy: its bucket name and its
# access key id must both differ from every copy in backup-worker.env and
# restore-drill.env. Its credential needs Put, Get, List and, so that a failed
# enrolment can remove what it wrote, Delete. The key that erases a spare at
# tenant erasure is a separate credential and is not set here.
ENROL_BACKUP_SPARE_BUCKET=SPARE_BUCKET_NAME
ENROL_BACKUP_SPARE_ENDPOINT=SPARE_BUCKET_ENDPOINT
ENROL_BACKUP_SPARE_REGION=SPARE_BUCKET_REGION
ENROL_BACKUP_SPARE_ACCESS_KEY_ID=SPARE_ENROLMENT_KEY_ID
ENROL_BACKUP_SPARE_SECRET_ACCESS_KEY=SPARE_ENROLMENT_KEY_SECRET
# The public age recipient every spare is encrypted to. It is not any tenant's
# recipient and never appears on a dump; its private half is held off this host.
ENROL_BACKUP_SPARE_WRAPPING_RECIPIENT=WRAPPING_AGE_RECIPIENT
# Lowercase hex SHA256 of the recipient text above, minted off this host.
# The enrolment prints the fingerprint it computes on every run and refuses on a
# mismatch, so swapping the recipient for another valid one cannot go unnoticed.
ENROL_BACKUP_SPARE_WRAPPING_RECIPIENT_SHA256=WRAPPING_RECIPIENT_SHA256_HEX

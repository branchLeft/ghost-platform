# /etc/branchleft/backup-worker.env -- root:root, mode 0600. Every name below
# is required; install_backup_worker.py refuses to enable the timer until each
# one is set. Values are placeholders and never belong in this file.
BACKUP_WORKER_DB_HOST=DB_HOST_PRIVATE_ADDRESS
BACKUP_WORKER_MYSQL_USER=BACKUP_ACCOUNT_NAME
BACKUP_WORKER_MYSQL_SSL_CA=PATH_TO_DB_SERVER_CA
DB_DUMP_MYSQL_PWD=BACKUP_ACCOUNT_PASSWORD
AGE_RECIPIENT_PUBLIC_KEY=AGE_RECIPIENT
BACKUP_WORKER_COPY_PRIMARY_BUCKET=BACKUP_BUCKET_NAME
BACKUP_WORKER_COPY_PRIMARY_ENDPOINT=BACKUP_BUCKET_ENDPOINT
BACKUP_WORKER_COPY_PRIMARY_REGION=BACKUP_BUCKET_REGION
BACKUP_WORKER_COPY_PRIMARY_ACCESS_KEY_ID=WORKER_PUT_KEY_ID
BACKUP_WORKER_COPY_PRIMARY_SECRET_ACCESS_KEY=WORKER_PUT_KEY_SECRET

# /etc/branchleft/restore-drill.env -- root:root, mode 0600. Every name below
# is required except the SECONDARY copy, which is set in full or not at all.
# install_restore_drill.py refuses to enable the timer until each required
# name is set. Values are placeholders and never belong in this file.
BACKUP_DRILL_COPY_PRIMARY_BUCKET=BACKUP_BUCKET_NAME
BACKUP_DRILL_COPY_PRIMARY_ENDPOINT=BACKUP_BUCKET_ENDPOINT
BACKUP_DRILL_COPY_PRIMARY_REGION=BACKUP_BUCKET_REGION
BACKUP_DRILL_COPY_PRIMARY_ACCESS_KEY_ID=DRILL_GET_LIST_KEY_ID
BACKUP_DRILL_COPY_PRIMARY_SECRET_ACCESS_KEY=DRILL_GET_LIST_KEY_SECRET
BACKUP_DRILL_RECOVERY_IMAGE=ghcr.io/branchleft/db-recovery@sha256:RECOVERY_IMAGE_DIGEST
BACKUP_DRILL_MYSQL_IMAGE=mysql:8.0@sha256:DB_SERVER_IMAGE_DIGEST
BACKUP_DRILL_GHOST_IMAGE=ghcr.io/branchleft/ghost-tenant@sha256:TENANT_IMAGE_DIGEST
BACKUP_DRILL_SIDECAR_IMAGE=ghcr.io/branchleft/drain-sidecar@sha256:SIDECAR_IMAGE_DIGEST

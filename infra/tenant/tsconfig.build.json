{
  "extends": "./tsconfig.json",
  // The shared base sets `noEmit`, because most projects extending it only ever
  // type-check. This is the config the published package is built from.
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

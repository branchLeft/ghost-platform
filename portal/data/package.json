{
  "name": "ghost-platform-portal-data",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "description": "The portal's storage layer over PostgreSQL: a tenant-facing query cannot be expressed without a tenant bound at the session, and the owner console's cross-tenant reads sit behind a separate entry point (see ghost-platform-docs/19-try-it-now-design/08-portal.html sections 01, 10 and 10b).",
  "type": "module",
  "exports": {
    "./tenant": "./dist/tenant/index.js",
    "./owner": "./dist/owner/index.js",
    "./migrate": "./dist/migrate.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "check:isolation": "node dist/checkIsolation.js",
    "provision": "node dist/provisionMain.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@branchleft/tsconfig": "^0.4.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}

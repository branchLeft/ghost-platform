      "policies": {},
      "checkConstraints": {
        "demo_state_event_transition_allowed": {
          "name": "demo_state_event_transition_allowed",
          "value": "(\"portal\".\"demo_state_event\".\"from_state\" IS NULL AND \"portal\".\"demo_state_event\".\"sequence\" = 1 AND \"portal\".\"demo_state_event\".\"to_state\" = 'VERIFIED') OR (\"portal\".\"demo_state_event\".\"from_state\" IS NOT NULL AND ((from_state = 'VERIFIED' AND to_state IN ('CLAIMED', 'WAITING')) OR (from_state = 'WAITING' AND to_state IN ('CLAIMED')) OR (from_state = 'CLAIMED' AND to_state IN ('PROVISIONING', 'WAITING', 'KILLED', 'FROZEN')) OR (from_state = 'PROVISIONING' AND to_state IN ('LIVE', 'FAILED', 'KILLED', 'FROZEN')) OR (from_state = 'LIVE' AND to_state IN ('EXPIRING', 'EXTENDED', 'PROMOTING', 'REBUILDING', 'KILLED', 'FROZEN')) OR (from_state = 'EXTENDED' AND to_state IN ('EXPIRING', 'PROMOTING', 'KILLED', 'FROZEN')) OR (from_state = 'EXPIRING' AND to_state IN ('PURGED', 'EXTENDED', 'PROMOTING', 'KILLED', 'FROZEN')) OR (from_state = 'REBUILDING' AND to_state IN ('LIVE', 'FAILED', 'KILLED', 'FROZEN')) OR (from_state = 'PROMOTING' AND to_state IN ('PROMOTED', 'LIVE', 'EXTENDED', 'EXPIRING', 'KILLED', 'FROZEN'))))"
        },
        "demo_state_event_sequence_chain": {
          "name": "demo_state_event_sequence_chain",
          "value": "\"portal\".\"demo_state_event\".\"sequence\" >= 1 AND (\"portal\".\"demo_state_event\".\"sequence\" = 1) = (\"portal\".\"demo_state_event\".\"previous_sequence\" IS NULL) AND (\"portal\".\"demo_state_event\".\"previous_sequence\" IS NULL) = (\"portal\".\"demo_state_event\".\"from_state\" IS NULL) AND (\"portal\".\"demo_state_event\".\"previous_sequence\" IS NULL OR \"portal\".\"demo_state_event\".\"previous_sequence\" = \"portal\".\"demo_state_event\".\"sequence\" - 1)"
        },
        "demo_state_event_lease_complete": {
          "name": "demo_state_event_lease_complete",
          "value": "(\"portal\".\"demo_state_event\".\"lease_issued_at\" IS NULL) = (\"portal\".\"demo_state_event\".\"lease_ends_at\" IS NULL)"
        },
        "demo_state_event_lease_finite": {
          "name": "demo_state_event_lease_finite",
          "value": "\"portal\".\"demo_state_event\".\"lease_ends_at\" > \"portal\".\"demo_state_event\".\"lease_issued_at\""
        },
        "demo_state_event_lease_by_state": {
          "name": "demo_state_event_lease_by_state",
          "value": "(\"portal\".\"demo_state_event\".\"to_state\" IN ('VERIFIED', 'WAITING', 'CLAIMED') AND \"portal\".\"demo_state_event\".\"lease_ends_at\" IS NULL) OR (\"portal\".\"demo_state_event\".\"to_state\" IN ('PROVISIONING', 'LIVE', 'EXTENDED', 'EXPIRING', 'REBUILDING', 'PROMOTING', 'PROMOTED', 'PURGED') AND \"portal\".\"demo_state_event\".\"lease_ends_at\" IS NOT NULL) OR \"portal\".\"demo_state_event\".\"to_state\" IN ('FAILED', 'KILLED', 'FROZEN')"
        },
        "demo_state_event_term_set": {
          "name": "demo_state_event_term_set",
          "value": "\"portal\".\"demo_state_event\".\"to_state\" <> 'PROVISIONING' OR (\"portal\".\"demo_state_event\".\"lease_issued_at\" = \"portal\".\"demo_state_event\".\"recorded_at\" AND \"portal\".\"demo_state_event\".\"lease_ends_at\" = \"portal\".\"demo_state_event\".\"lease_issued_at\" + make_interval(hours => 168))"
        },
        "demo_state_event_extension_only_extended": {
          "name": "demo_state_event_extension_only_extended",
          "value": "\"portal\".\"demo_state_event\".\"extension_days\" >= 0 AND (\"portal\".\"demo_state_event\".\"extension_days\" = 0 OR \"portal\".\"demo_state_event\".\"to_state\" = 'EXTENDED')"
        }
      },
      "isRLSEnabled": false

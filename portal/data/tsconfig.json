{
  // strict-1 alone, same reasoning as services/broker: a plain Node library
  // with no Pulumi resources and no browser target.
  "extends": "@branchleft/tsconfig/strict-1.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "provision/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "drizzle.test.config.ts"
  ]
}

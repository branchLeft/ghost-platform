# Runs the collector 60 seconds after the last run finished, so runs never overlap.
# Not Persistent: a minute missed while the host was down is not replayed, and each
# reading carries the host's own time, so the page knows how old it is.
[Unit]
Description=Carry each app host's support-access state into the portal, every minute

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=1s

[Install]
WantedBy=timers.target

{"nodes": [{"id": "readme_ghost_platform_repo", "label": "ghost-platform repository", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tenant_container_image", "label": "Tenant Ghost container image (Dockerfile)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_s3storage_adapter", "label": "Ghost's built-in S3Storage adapter", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fail_closed_storage_guard", "label": "Fail-closed storage guard (docker-entrypoint.branchleft.sh)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ghost defaults to LocalImagesStorage/LocalMediaStorage/LocalFilesStorage, which silently loses uploaded media on every Cloud Run instance recycle with no error, no log line, no alert. The entrypoint refuses to start Ghost's server process unless storage__active=S3Storage and all fields a working upload needs are present, converting a silent data-loss failure into a loud boot failure. The escape hatch BRANCHLEFT_ALLOW_LOCAL_STORAGE=true must be set explicitly -- never inferred from NODE_ENV or Cloud Run's K_SERVICE, since a heuristic would eventually let a real tenant through silently."}, {"id": "readme_env_var_convention_correction", "label": "Correction: Ghost env vars have no GHOST_ prefix", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified against ghost/core's shared/config/loader.ts, which calls nconf.env({separator:'__', parseValues:true}) with no prefix option, and against docs.ghost.org's own lowercase examples (database__connection__host). The story brief and ghost-platform-docs doc 03 incorrectly assumed a GHOST_-prefixed convention; this image, its README, and its smoke test use the correct unprefixed one."}, {"id": "readme_smoke_test_script", "label": "scripts/smoke-test.sh", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_storage_guard_test_script", "label": "scripts/test-storage-guard.sh", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_storage_guard_test_script", "target": "readme_fail_closed_storage_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_fail_closed_storage_guard", "target": "readme_s3storage_adapter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_s3storage_adapter", "target": "readme_tenant_container_image", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_env_var_convention_correction", "target": "readme_fail_closed_storage_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ghost_platform_repo", "target": "infra_readme_platform_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_ghost_platform_repo", "target": "infra_platfor
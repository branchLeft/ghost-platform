{
  "name": "ghost-platform",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.17.0",
  "description": "Repo-root tooling only. The publishable package is infra/tenant.",
  "type": "module",
  "prettier": "@branchleft/prettier-config",
  "scripts": {
    "lint": "eslint infra services render-core --ext .ts --fix",
    "lint:check": "eslint infra services render-core --ext .ts",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path node_modules/@branchleft/prettier-config/prettierignore",
    "test": "node --test *.test.js",
    "prepare": "[ \"$CI\" = \"true\" ] || pre-commit install"
  },
  "devDependencies": {
    "@branchleft/prettier-config": "^0.8.3",
    "@eslint/js": "^9.39.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}

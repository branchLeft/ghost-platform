
# Duplicated from the repo root rather than inherited: pnpm reads .npmrc from
# the working directory, the user home and the global prefix -- it does not
# walk up to a parent project. `pnpm install` run here would resolve @branchleft/*
# from npmjs and 404. See ../../.npmrc for the token setup.
@branchleft:registry=https://npm.pkg.github.com

# Installed at /etc/systemd/system/branchleft-broker.service (RUNBOOK-broker-deploy.md's
# install step). Runs the bundled artefacts `npm run bundle` produces
# (esbuild.bundle.mjs) under the unprivileged `broker` host user, which
# reaches root only through `sudo -n` into the sudoers-enumerated wrapper
# (`demo-host/provision/branchleft_slot.py`) -- never anything wider.
#
# Hardening: every directive below was kept only after a real boot proved it
# compatible with that `sudo -n` call actually reaching the wrapper -- not
# merely that the unit starts (RUNBOOK-broker-deploy.md's "Proof" section,
# .github/workflows/broker-systemd-boot-ci.yml). The rule the proof found,
# stated once rather than per directive: **on this unit's `User=broker`
# (non-root, no capabilities), ANY directive the kernel implements via a
# seccomp filter (`seccomp(2)`) forces the kernel's own `no_new_privs` bit,
# regardless of what `NoNewPrivileges=` is configured to** -- installing a
# seccomp filter on a process without `CAP_SYS_ADMIN` requires it. This
# is invisible from `systemctl show -p NoNewPrivileges` (which kept
# reporting `no`, correctly describing systemd's own setting) and only
# showed up in `/proc/<pid>/status`'s `NoNewPrivs` on the actually-running
# process. Tested individually against a real boot, not assumed from
# systemd's docs (this PR's body has the full grid): `SystemCallFilter=`,
# `SystemCallArchitectures=`, `RestrictAddressFamilies=`,
# `RestrictNamespaces=`, `RestrictRealtime=`, `LockPersonality=`,
# `RestrictSUIDSGID=`, `MemoryDenyWriteExecute=`, and -- less obviously,
# since these read as filesystem/namespace controls -- `ProtectClock=`,
# `ProtectKernelTunables=`, `ProtectKernelModules=`, `ProtectKernelLogs=`
# and `ProtectHostname=` ALL forced it and are absent below as a result.
# `CapabilityBoundingSet=` (narrowed to empty) is also absent, for a
# different reason: a setuid-root exec (capabilities(7)) grants the new
# process capabilities out of the CALLING process's own bounding set, not
# just the target file's bits, so narrowing it here would cap what
# `branchleft-slot` itself can hold as root even though sudo's own grant
# already scoped what it may run.
#
# What remains below -- `ProtectSystem`, `ProtectHome`, `PrivateTmp`,
# `ProtectControlGroups`, `ProtectProc`, plus `UMask` and `StateDirectory`,
# neither of which is a restriction on the process at all -- was each
# tested individually against the same real boot and confirmed not to set
# `no_new_privs`; the proof's real signed `POST /reset` reaches
# `branchleft_slot.py` through `sudo -n` and gets a real reply with every
# one of them applied together. `NoNewPrivileges=no` stays explicit even
# though nothing left below implies otherwise: cheap, and it is the line a
# future edit re-adding a seccomp-backed directive would need to notice
# contradicts.

[Unit]
Description=branchLeft demo-host broker
Documentation=https://github.com/branchLeft/ghost-platform/blob/main/services/broker/RUNBOOK-broker-deploy.md
After=network.target

[Service]
Type=simple
User=broker
Group=broker

EnvironmentFile=/etc/branchleft/broker.env
WorkingDirectory=/opt/branchleft/broker/current
# --preserve-symlinks-main: without it, `broker.mjs#isEntryPoint`'s own
# `import.meta.url === pathToFileURL(process.argv[1]).href` check is false
# here -- Node resolves `import.meta.url` through the `current` symlink to
# its target under `releases/<release>/`, but never re-resolves
# `process.argv[1]`, so the two URLs disagree and `main()` silently never
# runs (proved by a real boot with the flag left off: the unit exits
# 0/SUCCESS in under two seconds, no log line, nothing listening). The
# atomic-upgrade symlink (RUNBOOK-broker-deploy.md) is only safe with this
# flag present.
ExecStart=/opt/branchleft/broker/node/bin/node --preserve-symlinks-main /opt/branchleft/broker/current/broker.mjs

Restart=on-failure
RestartSec=5s
# A broker stuck in a fast crash loop is an operator problem, not something
# this unit should paper over by respawning it forever at the sudoers
# boundary's own front door.
StartLimitIntervalSec=300
StartLimitBurst=6

TimeoutStopSec=30s

# Creates and owns /var/lib/branchleft-broker (broker:broker, 0750) on every
# start -- the fixed path `demo-host/provision/branchleft_slot.py`'s
# IMAGE_LOAD_PATH already hardcodes for `image-tmp/image.tar`. The
# process's own startup (`server.ts#main`) creates the `state/`,
# `lease/`, `drain-flags/` and `image-tmp/` subdirectories under it.
StateDirectory=branchleft-broker
StateDirectoryMode=0750

# --- Hardening compatible with the sudo -n call (see header) ---
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectProc=invisible
UMask=0077

# `/opt/branchleft/demo-<slot>` (`BROKER_SLOT_DIR_BASE`) is where
# `/reconcile` writes rendered artefacts (`writeArtefacts.ts`) -- owned and
# permissioned by the host-build/uid-claim work (branchLeft/workspace#1447,
# #1448), not this unit. Left writable here so this unit does not itself
# regress that path once it exists; ProtectSystem=strict would otherwise
# make it read-only regardless of what ownership the other story sets up.
#
# /etc/branchleft is writable for a less obvious reason, found only by the
# proof's real signed `/reset`: `ProtectSystem=strict`'s read-only mount
# applies to this UNIT's whole process tree, including the `sudo`-elevated
# `branchleft_slot.py` it execs -- a mount namespace is inherited across
# exec regardless of which UID is now running in it, so gaining root via
# sudo does not on its own restore write access anywhere this unit made
# read-only. `branchleft_slot.py`'s own `reset` removes each colour's
# `/etc/branchleft/<slot>-<colour>.env` as part of tearing a slot down
# (ETC_DIR in that file) -- without this line, that `unlink()` failed with
# a real `Read-only file system` (this PR's body), even though the wrapper
# was, by that point, genuinely running as root.
ReadWritePaths=/opt/branchleft /etc/branchleft

[Install]
WantedBy=multi-user.target

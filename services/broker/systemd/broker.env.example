# Template for /etc/branchleft/broker.env -- installed root:root 0600
# (RUNBOOK-broker-deploy.md's install step: EnvironmentFile= is read by
# systemd as root before the process starts, so the broker account itself
# never needs read access to this file). Every value below is a
# placeholder; the install step fills in the real ones per-host.
#
# LISTEN_HOST is deliberately left unset here, not set to 0.0.0.0: ops1
# reaches this broker only through an SSH tunnel from edge1 (owner ruling,
# 2026-09-28), so it must stay loopback-only.
# `config.ts#loadConfig` already defaults to 127.0.0.1 when LISTEN_HOST is
# absent -- this file does not need to (and must not) override that.
# test/unit/listenHostDefault.test.ts is the sabotage-proven guard: it
# fails if this file, or any other committed template, ever sets
# LISTEN_HOST to anything but a loopback address.

PORT=8090

# The file this names is owned root:broker, mode 0640 -- readable by the
# broker account but not owned or writable by it. See
# ../systemd/README.md ("The verify key").
BROKER_VERIFY_KEY_FILE=/etc/branchleft/broker-verify-key.bin
# The broker's own directory under /var/lib/branchleft (broker:broker 0755):
# the parent stays root:root, because it also holds the health router's
# root-owned directory and whoever owns a parent can rename inside it.
BROKER_SLOTS_FILE=/var/lib/branchleft/broker-slots/slots.json
BROKER_LEASE_DIR=/var/lib/branchleft-broker/lease
BROKER_STATE_DIR=/var/lib/branchleft-broker/state
# The drain-flag directory is known to disagree with the demo host runbook;
# it is being corrected separately and is left as it was here.
BROKER_DRAIN_FLAG_DIR=/var/lib/branchleft-broker/drain-flags
BROKER_SLOT_DIR_BASE=/opt/branchleft
BROKER_IMAGE_TMP_DIR=/var/lib/branchleft-broker/image-tmp

BROKER_DEMO_ZONE=demo.trypublicpress.co.uk
BROKER_PLATFORM_ZONE=publicpress.co.uk
BROKER_OWNED_DOMAINS=demo.trypublicpress.co.uk,publicpress.co.uk
BROKER_DEMO_MAIL_DOMAIN=demo.trypublicpress.co.uk
BROKER_MAIL_SPOOL_BASE_URL=http://127.0.0.1:8095

# Plugin seams (server.ts#loadPlugin) -- refuses to start if unset or if the
# module's default export doesn't implement the seam. All four are shipped
# modules in this package's own dist/bundle/plugins/. The drain source
# refuses every poll for good: mail is collected from the mail queue
# directly. The admin client keeps the demo owner's staff access token.
# /status lists every loaded module not marked real under "notReal" (a test
# stand-in, or anything unmarked) and any interim module under "interim";
# the host is not ready to go live until both lists are empty.
BROKER_RENDERER_MODULE=/opt/branchleft/broker/current/plugins/renderCorePlugin.mjs
BROKER_IMAGE_LOADER_MODULE=/opt/branchleft/broker/current/plugins/dockerImageLoader.mjs
BROKER_ADMIN_API_MODULE=/opt/branchleft/broker/current/plugins/ghostAdminApi.mjs
# One private folder per slot (0700, broker-owned), each holding that
# demo's owner staff access token (0600). Never readable by Ghost or the
# router; a reset deletes the slot's token.
BROKER_ADMIN_KEY_DIR=/var/lib/branchleft/broker-slots/admin-keys
BROKER_DRAIN_SOURCE_MODULE=/opt/branchleft/broker/current/plugins/refusingDrainSource.mjs

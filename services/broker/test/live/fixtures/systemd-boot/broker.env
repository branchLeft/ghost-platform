# Proof-image env file -- not the shipped template (see
# ../../../../systemd/broker.env.example for that). Installed at the same
# path (/etc/branchleft/broker.env, root:root 0600) a real install uses, but
# points BROKER_ADMIN_API_MODULE/BROKER_DRAIN_SOURCE_MODULE at this proof's
# no-op stand-ins rather than "REPLACE-ME" -- the whole point is that the
# server can actually start and answer requests, not merely parse.
# LISTEN_HOST is not set here either: see broker.env.example's comment on why.

BROKER_VERIFY_KEY_FILE=/etc/branchleft/broker-verify-key.bin
BROKER_SLOTS_FILE=/var/lib/branchleft/slots.json
BROKER_LEASE_DIR=/var/lib/branchleft-broker/lease
BROKER_STATE_DIR=/var/lib/branchleft-broker/state
BROKER_DRAIN_FLAG_DIR=/var/lib/branchleft-broker/drain-flags
BROKER_SLOT_DIR_BASE=/opt/branchleft
BROKER_IMAGE_TMP_DIR=/var/lib/branchleft-broker/image-tmp

BROKER_DEMO_ZONE=demo.trypublicpress.co.uk
BROKER_PLATFORM_ZONE=publicpress.co.uk
BROKER_OWNED_DOMAINS=demo.trypublicpress.co.uk,publicpress.co.uk
BROKER_DEMO_MAIL_DOMAIN=demo.trypublicpress.co.uk
BROKER_MAIL_SPOOL_BASE_URL=http://127.0.0.1:8095

BROKER_RENDERER_MODULE=/opt/branchleft/broker/current/plugins/renderCorePlugin.mjs
BROKER_IMAGE_LOADER_MODULE=/opt/branchleft/broker/current/plugins/dockerImageLoader.mjs
BROKER_ADMIN_API_MODULE=/opt/branchleft/broker/current/plugins/noop-admin-api.mjs
BROKER_DRAIN_SOURCE_MODULE=/opt/branchleft/broker/current/plugins/noop-drain-source.mjs

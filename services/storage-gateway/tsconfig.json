{
  // strict-1 alone, same reasoning as services/drain-sidecar: no stack preset
  // fits a plain Node service with no Pulumi resources and no browser target.
  "extends": "@branchleft/tsconfig/strict-1.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  // vitest.config.ts and drizzle.config.ts are listed explicitly because
  // they sit at the project root, outside both source trees.
  // tsconfig.build.json narrows `include` back to src, so naming them here
  // cannot leak them into the published build.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "drizzle.config.ts"]
}

    "vectors:generate": "REGENERATE_REFERENCE_VECTORS=1 vitest run test/generate-reference-vectors.test.ts"
  },
  "devDependencies": {
    "@branchleft/tsconfig": "^0.4.0",
    "@smithy/signature-v4": "5.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3"
  }
}

{
  "name": "ghost-platform-mailgun-shim",
  "version": "0.0.0",
  "private": true,
  "description": "Mailgun-shaped shim that speaks the three endpoints Ghost's bulk-email path calls and relays to a self-hosted SMTP delivery host (see ghost-platform-docs/13-mail-architecture-options.md).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "4.1.10",
    "form-data": "^4.0.6",
    "mailgun.js": "10.4.0",
    "mailparser": "^3.7.1",
    "smtp-server": "^3.13.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}

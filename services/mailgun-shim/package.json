{
  "name": "ghost-platform-mailgun-shim",
  "version": "0.0.0",
  "private": true,
  "description": "Mailgun-shaped shim that speaks the three endpoints Ghost's bulk-email path calls, and hands queued mail over on a drain endpoint rather than dialling a delivery host itself (see ghost-platform-docs/19-try-it-now-design/06-mail-delivery.html).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "@branchleft/tsconfig": "^0.3.1",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "4.1.11",
    "form-data": "^4.0.6",
    "mailgun.js": "10.4.0",
    "mailparser": "^3.7.1",
    "nodemailer": "^9.1.1",
    "smtp-server": "^3.13.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}

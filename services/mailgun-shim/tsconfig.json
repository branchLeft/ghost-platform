{
  // strict-1 alone: no stack preset fits. `pulumi` pins ES2022 and pulls in
  // experimentalDecorators for resource classes this service has none of, and
  // the react presets are browser-targeted.
  "extends": "@branchleft/tsconfig/strict-1.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  // vitest.config.ts is listed explicitly because it sits at the project root,
  // outside both source trees. tsconfig.build.json narrows `include` back to
  // src, so naming it here cannot leak it into the published build.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}

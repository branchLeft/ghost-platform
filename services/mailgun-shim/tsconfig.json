{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  // vitest.config.ts is listed explicitly because it sits at the project root,
  // outside both source trees. tsconfig.build.json narrows `include` back to
  // src, so naming it here cannot leak it into the published build.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}

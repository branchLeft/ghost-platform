# DB-1 scope declaration (branchLeft/standards v0.8.0, docs/databases.md).
# Backup, restore and migration tooling that drives the database directly
# (mysqldump, a restore, a provisioning script) -- never application code.

# db1's backup pipeline: nightly/per-tenant dump, binlog extract/ship,
# tenant DB provisioning, bucket config, pruning, my.cnf rendering.
db/provision/*.py

# Instance-level restore tooling and its toolchain-version guard.
db/recovery/*.py

# The backup worker's own module and its bucket-fence policy source.
infra/provisioning/scripts/backup_*.py

# Their tests -- a separate line because test_* doesn't match backup_*.
infra/provisioning/scripts/test_backup_*.py

# The pull-encrypt-store transport the backup worker drives, and its test.
infra/provisioning/scripts/*pull_encrypt_store.py

# The export bundler's scratch-copy database: mysqldump/SQLite-backup into
# a throwaway target, never the tenant's live database.
services/export-bundler/*scratchDatabase*

# The individual declarations below overlap the globs above; each was checked
# against DB-1's definition on its own and names the operation it performs.

# Backup: logical dumps and binary-log shipping, taken on db1.
db/provision/dump_nightly.py
db/provision/dump_tenant.py
db/provision/test_dump_tenant.py
db/provision/ship_binlogs.py
db/provision/test_ship_binlogs.py

# Restore: scoping a point-in-time replay to one tenant, and restoring a dump.
db/provision/extract_tenant_binlog.py
db/provision/test_extract_tenant_binlog.py
db/recovery/*

# Backup: the control-side worker that pulls, encrypts and stores a dump.
infra/provisioning/scripts/backup_worker.py
infra/provisioning/scripts/test_backup_worker.py
infra/provisioning/scripts/test_pull_encrypt_store.py

# Backup: the per-tenant transport's tests read back the lock session's
# statements, which a real dump drives directly, never through the ORM.
infra/provisioning/scripts/test_dial_in_transport.py

# Backup: the nightly loop's own test fixtures fake mysqldump's output,
# literal INSERT INTO text a real dump never runs through the ORM.
infra/provisioning/scripts/test_nightly_dump_loop.py

# Restore: the export colour runs against a dump restored into a scratch server.
services/export-bundler/src/scratchDatabase.ts
services/export-bundler/test/unit/scratchDatabase.test.ts

# Provisioning: creating a tenant's database, user and grants.
db/provision/provision_tenant_db.py

# Operational check: whether a demo slot's Ghost still has an email batch
# submitting, read before a colour may be stopped.
demo-host/provision/branchleft_slot.py
demo-host/provision/test_branchleft_slot.py

# Test-harness probe: readiness of a test MySQL container.
adapters/sso/test/image/provision-support-account-mysql.image.test.mjs

# Provisioning: the portal's database roles, grants and logins, and the test
# suite's throwaway databases -- operator-run, never the portal at run time.
portal/data/provision/*

# The weekly restore drill: decrypts a backup, imports it into a throwaway
# server and reads back what it restored.
infra/provisioning/scripts/restore_drill.py
infra/provisioning/scripts/test_restore_drill.py

# Backup and restore check for the control host's Nextcloud stack: pg_dump,
# a restore into a throwaway server, and count queries, never row reads.
control/provision/nextcloud_backup.py
control/provision/test_nextcloud_backup.py
